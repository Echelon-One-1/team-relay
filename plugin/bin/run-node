#!/bin/sh
# Starts the plugin's bundles (dist/*.js) with a Node.js new enough for them (22.12 or newer,
# package.json "engines"), so the plugin does not depend on whatever `node` Claude Code's PATH
# has: the desktop app's PATH may have none, or an old one. .mcp.json, hooks/hooks.json and the `!` lines of commands/*.md run
#
#   /bin/sh ${CLAUDE_PLUGIN_ROOT}/bin/run-node ${CLAUDE_PLUGIN_ROOT}/dist/<bundle>.js [args]
#
# It uses, in this order:
#   1. the first `node` on PATH (absolute entries only), when it is 22.12 or newer;
#   2. the Node.js the setup line installs privately, ~/.local/share/team-relay/node-v<x.y.z>-*/
#      bin/node (relay/relay/static/setup.sh), the newest version there that runs;
#   3. on a Mac (arm64 or x86_64) only, the pinned Node.js build (bin/node-pins.sh, the same one
#      setup.sh installs), downloaded from nodejs.org over https, checked against its pinned SHA-256,
#      unpacked and renamed into that same private folder, so either installer's copy serves both.
#      One start downloads at a time (a lock folder there); the others wait for it, up to 120 s.
#      The download goes to one fixed file there (.node-<version>-darwin-<arch>.tar.gz.partial):
#      a download cut short (a slow or dropped connection: curl gives up after 20 s without a
#      connection or 60 s below 1 KiB/s) is resumed by the next start; the SHA-256 is checked on
#      the whole file, and a file that does not match is deleted. The lock holder also removes what
#      earlier starts left behind (download folders, other versions' partial files).
#      Any failure says in one plain line why, then exits 1.
# Elsewhere, with none found, it says in one plain line what to do and exits 1.
#
# POSIX sh. Its stdin and stdout belong to the bundle (the MCP servers speak on them), so every
# tool it runs reads nothing and writes nothing there; the tools are found on PATH.

MIN_MAJOR=22
MIN_MINOR=12

# Sets VMAJ, VMIN and VPAT to the version of the node at $1 when it runs and says vMAJOR.MINOR.PATCH
# (each at most 9 digits, so every comparison below is in range); fails otherwise. A node that
# hangs on --version blocks here: POSIX sh has no portable timeout.
node_version() {
  v=$("$1" --version 2>/dev/null </dev/null) || return 1
  v=${v#v}
  case "$v" in *.*.*) ;; *) return 1 ;; esac
  VMAJ=${v%%.*}
  rest=${v#*.}
  VMIN=${rest%%.*}
  VPAT=${rest#*.}
  VPAT=${VPAT%%[!0-9]*}
  for n in "$VMAJ" "$VMIN" "$VPAT"; do
    case "$n" in '' | *[!0-9]* | ??????????*) return 1 ;; esac
  done
  return 0
}

# Whether VMAJ.VMIN is new enough (a comparison that errors refuses).
new_enough() {
  { [ "$VMAJ" -gt "$MIN_MAJOR" ] || { [ "$VMAJ" -eq "$MIN_MAJOR" ] && [ "$VMIN" -ge "$MIN_MINOR" ]; }; } 2>/dev/null
}

# The first `node` on PATH, from absolute PATH entries only: an empty or relative entry (".",
# "::") would run a node from whatever folder Claude Code started in, so it is skipped.
first_path_node() {
  rest=${PATH:-}
  last=
  while :; do
    case "$rest" in
      *:*) entry=${rest%%:*}; rest=${rest#*:} ;;
      *) entry=$rest; rest= ; last=1 ;;
    esac
    case "$entry" in
      /*) if [ -f "$entry/node" ] && [ -x "$entry/node" ]; then printf '%s\n' "$entry/node"; return 0; fi ;;
    esac
    [ -n "${last:-}" ] && return 1
  done
}

found=""
path_node=$(first_path_node)
case "$path_node" in /*) ;; *) path_node= ;; esac
if [ -n "$path_node" ] && node_version "$path_node" && new_enough; then
  found=$path_node
fi

if [ -z "$found" ] && [ -n "${HOME:-}" ]; then
  bmaj=-1
  bmin=0
  bpat=0
  for dir in "$HOME"/.local/share/team-relay/node-v*-*; do
    candidate=$dir/bin/node
    [ -x "$candidate" ] || continue
    node_version "$candidate" && new_enough || continue
    if { [ "$VMAJ" -gt "$bmaj" ] \
      || { [ "$VMAJ" -eq "$bmaj" ] && [ "$VMIN" -gt "$bmin" ]; } \
      || { [ "$VMAJ" -eq "$bmaj" ] && [ "$VMIN" -eq "$bmin" ] && [ "$VPAT" -gt "$bpat" ]; }; } 2>/dev/null; then
      found=$candidate
      bmaj=$VMAJ
      bmin=$VMIN
      bpat=$VPAT
    fi
  done
fi

# ---------------------------------------------------------------- 3. the pinned download
# Where the download goes, a lock taken by this start, and the pinned copy for this Mac.
WORK_DIR=""
LOCK=""
HAVE_LOCK=""
PRIVATE_DIR=""
PINNED_DIR=""
PINNED_NODE=""
PARTIAL=""

cleanup() {
  if [ -n "$WORK_DIR" ]; then rm -rf "$WORK_DIR" >/dev/null 2>&1; WORK_DIR=""; fi
  if [ -n "$HAVE_LOCK" ]; then rm -rf "$LOCK" >/dev/null 2>&1; HAVE_LOCK=""; fi
}

# One plain line on stderr, nothing left behind, exit 1.
cannot_get() {
  cleanup
  echo "Could not get Node.js for the team relay: $1. Check your internet connection and restart Claude." >&2
  exit 1
}

# Whether the pinned copy for this Mac is there, runs and is new enough.
pinned_ok() {
  [ -x "$PINNED_NODE" ] && node_version "$PINNED_NODE" && new_enough
}

# Removes the lock folder of a start that is gone: renamed to a name only this start uses first
# (so the lock's name is free at once and no other start's lock is ever removed), then deleted.
drop_dead_lock() {
  gone="$PRIVATE_DIR/.node-download.stale.$$"
  rm -rf "$gone" >/dev/null 2>&1
  if mv "$LOCK" "$gone" >/dev/null 2>&1; then rm -rf "$gone" >/dev/null 2>&1; fi
}

# Takes the lock folder, or waits (sleep 1, at most 120 times) for the start holding it. Returns 0
# with the lock held, 2 when the pinned copy appeared meanwhile. A lock whose owner is no longer
# running is taken over at once; one that never says its owner, after the whole wait. When two
# starts find the same dead owner, only the one that renames its pid file away takes the lock
# over; a pid file that turns out to name another owner (the lock was taken over and taken again
# meanwhile) is put back and waited for.
take_lock() {
  waited=0
  while :; do
    if mkdir "$LOCK" >/dev/null 2>&1; then
      HAVE_LOCK=1
      echo "$$" >"$LOCK/pid" 2>/dev/null || cannot_get "its folder could not be written"
      return 0
    fi
    pinned_ok && return 2
    owner=""
    if [ -f "$LOCK/pid" ]; then IFS= read -r owner <"$LOCK/pid" || :; fi
    case "$owner" in
      '' | *[!0-9]* | ??????????*) owner="" ;;
    esac
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
      taken="$LOCK/pid.taken.$$"
      if mv "$LOCK/pid" "$taken" >/dev/null 2>&1; then
        again=""
        IFS= read -r again <"$taken" || :
        if [ "$again" = "$owner" ]; then
          drop_dead_lock
        else
          mv "$taken" "$LOCK/pid" >/dev/null 2>&1 || :
        fi
        continue
      fi
    fi
    if [ "$waited" -ge 120 ]; then
      if [ -z "$owner" ] && [ -z "${took_over:-}" ]; then
        took_over=1
        drop_dead_lock
        continue
      fi
      cannot_get "another start of the team relay is still getting it"
    fi
    sleep 1 >/dev/null 2>&1
    waited=$((waited + 1))
  done
}

# Whether the downloaded file is complete: its SHA-256 is the pinned one.
partial_ok() {
  [ -f "$PARTIAL" ] && [ ! -L "$PARTIAL" ] || return 1
  got=$(shasum -a 256 "$PARTIAL" 2>/dev/null </dev/null) || got=""
  got=${got%% *}
  [ -n "$got" ] && [ "$got" = "$NODE_SHA256" ]
}

# What earlier starts left behind; only the lock holder runs this, so none of it is in use.
remove_leftovers() {
  for old in "$PRIVATE_DIR"/.download.* "$PRIVATE_DIR"/.node-download.stale.* "$PRIVATE_DIR"/.node-*.tar.gz.partial; do
    [ "$old" = "$PARTIAL" ] && continue
    if [ -e "$old" ] || [ -L "$old" ]; then rm -rf "$old" >/dev/null 2>&1 || :; fi
  done
  # The partial file is a plain file or nothing.
  if [ -L "$PARTIAL" ] || { [ -e "$PARTIAL" ] && [ ! -f "$PARTIAL" ]; }; then
    rm -rf "$PARTIAL" >/dev/null 2>&1 || cannot_get "its folder could not be written"
  fi
}

download_node() {
  name="node-$NODE_VERSION-darwin-$NODE_ARCH"
  remove_leftovers
  if ! partial_ok; then
    rc=0
    curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 20 --speed-limit 1024 --speed-time 60 \
      -C - -o "$PARTIAL" "https://nodejs.org/dist/$NODE_VERSION/$name.tar.gz" >/dev/null 2>&1 </dev/null || rc=$?
    if [ "$rc" -ne 0 ]; then
      # The server cannot resume this file (33, 36): the next start begins again.
      case "$rc" in 33 | 36) rm -f "$PARTIAL" >/dev/null 2>&1 ;; esac
      cannot_get "the download did not work"
    fi
    if ! partial_ok; then
      rm -f "$PARTIAL" >/dev/null 2>&1
      cannot_get "the download was not the file it should be"
    fi
  fi
  WORK_DIR=$(mktemp -d "$PRIVATE_DIR/.download.XXXXXX" 2>/dev/null </dev/null) || WORK_DIR=""
  case "$WORK_DIR" in "$PRIVATE_DIR"/.download.*) ;; *) WORK_DIR=""; cannot_get "its folder could not be made" ;; esac
  if ! tar -xzf "$PARTIAL" -C "$WORK_DIR" >/dev/null 2>&1 </dev/null \
    || [ ! -f "$WORK_DIR/$name/bin/node" ] || [ ! -x "$WORK_DIR/$name/bin/node" ]; then
    rm -f "$PARTIAL" >/dev/null 2>&1
    cannot_get "the download could not be unpacked"
  fi
  # Unpacked: the file has served its purpose.
  rm -f "$PARTIAL" >/dev/null 2>&1
  # Another start may have put a working copy in place meanwhile: that one is used, this download
  # dropped. A copy there that does not run is set aside (and removed with the download folder),
  # then the unpacked one is renamed into place, so a half-unpacked copy is never used.
  if pinned_ok; then return 0; fi
  if [ -e "$PINNED_DIR" ] || [ -L "$PINNED_DIR" ]; then
    mv "$PINNED_DIR" "$WORK_DIR/old" >/dev/null 2>&1 || cannot_get "its old copy could not be replaced"
  fi
  mv "$WORK_DIR/$name" "$PINNED_DIR" >/dev/null 2>&1 || cannot_get "the download could not be put in place"
  if ! pinned_ok; then
    mv "$PINNED_DIR" "$WORK_DIR/bad" >/dev/null 2>&1 || :
    cannot_get "the Node.js it got does not run on this computer"
  fi
}

if [ -z "$found" ] && [ -n "${HOME:-}" ]; then
  os=$(uname -s 2>/dev/null) || os=""
  machine=$(uname -m 2>/dev/null) || machine=""
  case "$os:$machine" in
    Darwin:arm64) NODE_ARCH=arm64 ;;
    Darwin:x86_64) NODE_ARCH=x64 ;;
    *) NODE_ARCH="" ;;
  esac
  if [ -n "$NODE_ARCH" ]; then
    case "$0" in */*) here=${0%/*} ;; *) here=. ;; esac
    NODE_VERSION=""
    NODE_SHA256_ARM64=""
    NODE_SHA256_X64=""
    if [ -f "$here/node-pins.sh" ] && [ -r "$here/node-pins.sh" ]; then
      # shellcheck source-path=SCRIPTDIR source=node-pins.sh
      . "$here/node-pins.sh"
    fi
    if [ "$NODE_ARCH" = arm64 ]; then NODE_SHA256=$NODE_SHA256_ARM64; else NODE_SHA256=$NODE_SHA256_X64; fi
    case "$NODE_VERSION" in v[0-9]*.[0-9]*.[0-9]*) ;; *) cannot_get "its pinned version is missing" ;; esac
    case "$NODE_VERSION" in *[!v0-9.]*) cannot_get "its pinned version is missing" ;; esac
    case "$NODE_SHA256" in *[!0-9a-f]* | '') cannot_get "its pinned version is missing" ;; esac
    [ ${#NODE_SHA256} -eq 64 ] || cannot_get "its pinned version is missing"

    PRIVATE_DIR=$HOME/.local/share/team-relay
    PINNED_DIR=$PRIVATE_DIR/node-$NODE_VERSION-darwin-$NODE_ARCH
    PINNED_NODE=$PINNED_DIR/bin/node
    LOCK=$PRIVATE_DIR/.node-download.lock
    PARTIAL=$PRIVATE_DIR/.node-$NODE_VERSION-darwin-$NODE_ARCH.tar.gz.partial
    trap cleanup EXIT
    trap 'exit 1' HUP INT TERM
    if ! mkdir -p "$PRIVATE_DIR" >/dev/null 2>&1 || ! chmod 700 "$PRIVATE_DIR" >/dev/null 2>&1; then
      cannot_get "its folder could not be made"
    fi
    if take_lock; then
      # The start that held the lock before may have finished just now.
      pinned_ok || download_node
    fi
    cleanup
    trap - EXIT HUP INT TERM
    found=$PINNED_NODE
    exec "$found" "$@"
  fi
fi

if [ -z "$found" ]; then
  echo "Team relay needs its helper: paste the setup line from your team page into Terminal again." >&2
  exit 1
fi
exec "$found" "$@"
