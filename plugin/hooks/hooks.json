{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/run-node",
              "${CLAUDE_PLUGIN_ROOT}/dist/session-start.js"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
