# Copy to config/deploy.local.env (git-ignored). The deploy scripts source it. No secrets here:
# OAuth client files are passed by path on the command line and stored in Secret Manager.
PROJECT=your-project
# The Cloud Run region, for example:
REGION=europe-west1
# The team id the hosted console serves by default (one of the teams in config/team.local.yaml).
TEAM=your-team
# Optional: where teammates clone this repository; shown in the console's join panel.
# JOIN_REPO_URL=https://github.com/example-org/team-relay

# One address for the relay and the console (scripts/deploy-lb.sh, M10-SPEC §5). Unset, the
# services answer on their run.app URLs instead.
PUBLIC_HOST=relay.example.com
# Who may pass IAP to the console behind the load balancer (required by deploy-lb.sh; never
# allUsers): domain:<domain>, group:<email>, user:<email>, comma-separated.
IAP_ACCESS=domain:example.com

# Whose Google accounts may use the relay at all (M10-SPEC §7.2): comma-separated lower-case
# domains, passed to the relay as RELAY_ALLOWED_DOMAINS. The relay then refuses every other
# account on every route (sign-in, ID tokens, invitations, roster adds, team creation). Unset,
# ANY Google account can sign in and use the relay's API (create a team, for one):
# scripts/deploy.sh warns, and with PUBLIC_HOST set it stops unless you also set
# CONFIRM_OPEN_RELAY=1 to choose that on purpose.
ALLOWED_DOMAINS=example.com
# CONFIRM_OPEN_RELAY=1

# The one-command setup (M11-SPEC §5): the GitHub owner/repo whose .claude-plugin/marketplace.json
# lists the plugin. scripts/deploy.sh passes it to the relay as RELAY_PLUGIN_MARKETPLACE, and the
# relay then serves `curl -fsSL https://PUBLIC_HOST/setup | bash` (needs PUBLIC_HOST). Unset, /setup
# answers 404.
PLUGIN_MARKETPLACE=example-org/team-relay

# Optional: the name the public sign-in page at https://PUBLIC_HOST/ shows ("Use your Example Co
# Google account"; docs/SIGNIN-PAGE.md). 1 to 40 letters, digits, spaces and & . , ' -. Quote it
# when it holds a space. scripts/deploy.sh passes it to the relay as RELAY_BRAND_NAME. Unset, the
# page says just "Team Relay" and "For team members."
# BRAND_NAME="Example Co"

# scripts/deploy.sh refuses to remove a setting or secret mount that is live on the service but
# unset here; name it to remove it on purpose (comma-separated setting names).
# CONFIRM_REMOVE=RELAY_BRAND_NAME
